#!/bin/sh
set -e

#DEBHELPER#

# mc 4.8.30 and newer read mc.ext.ini, older versions read mc.ext, so both files get
# an entry for *.hdd images. In mc.ext.ini a backslash is written twice.
ext_ini_block() {
	cat <<-EOF

		# hdd images
		[hdd]
		Regex=\\\\.hdd\$
		RegexIgnoreCase=true
		Open=%cd %p/uhdd://
	EOF
}

ext_block() {
	cat <<-EOF

		# hdd images
		regex/\\.([hH][dD][dD])\$
		  Open=%cd %p/uhdd://
	EOF
}

# In mc.ext.ini the block goes right below the file metadata, before every other
# section: mc takes the first match. mc.ext has no metadata, hence the marker.
insert_after() {
	marker=$1
	orig=$2
	target=$3
	block=$4

	{
		sed -n "1,/$marker/p" "$orig"
		$block
		sed "1,/$marker/d" "$orig"
	} > "$target"
}

case "$1" in

	configure)
		insert_after '^Version[[:space:]]*=' \
			/etc/mc/mc.ext.ini.mc-fdd.mc-hdd-orig /etc/mc/mc.ext.ini.mc-fdd.mc-hdd ext_ini_block
		insert_after '^### Miscellaneous ###' \
			/etc/mc/mc.ext.mc-fdd.mc-hdd-orig /etc/mc/mc.ext.mc-fdd.mc-hdd ext_block
	;;

	*)
		exit 0
	;;

esac

exit 0
